# Configuration SACRA - À renommer en .env et compléter

# Flask
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Stripe (récupérer sur https://dashboard.stripe.com/)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Prix Stripe (créer les produits sur Stripe Dashboard)
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# Email (SMTP o2switch)
# Serveur SMTP o2switch - SSL (port 465)
MAIL_SERVER=mail.saccra.fr
MAIL_PORT=465
MAIL_USERNAME=contact@saccra.fr
MAIL_PASSWORD=ton-mot-de-passe-email
MAIL_DEFAULT_SENDER=contact@saccra.fr
ADMIN_EMAIL=contact@saccra.fr

# Notes:
# - Port 465 = SSL direct (SMTP_SSL)
# - Port 587 = TLS avec STARTTLS
# - Serveur entrant (IMAP): mail.saccra.fr:993
# - Serveur entrant (POP3): mail.saccra.fr:995
# - Authentification requise pour SMTP, IMAP et POP3
